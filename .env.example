# Default public API; no token required.
CONTENT_PROVIDER=tvmaze
CONTENT_GENERATION=1
# Increase CONTENT_GENERATION whenever changing provider in a published build.
# Optional HTTPS global manifest: provider, deploymentId, generation, phase.
CONTENT_CONFIG_URL=
TVMAZE_BASE_URL=https://api.tvmaze.com
# Switch CONTENT_PROVIDER to tmdb and increase CONTENT_GENERATION when needed.
TMDB_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3
